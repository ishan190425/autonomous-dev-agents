{
  "name": "@ada-ai/cli",
  "version": "1.0.0-alpha",
  "description": "CLI tool for Autonomous Dev Agents — set up and run AI agent teams on any repo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ada": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --passWithNoTests",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=4096' vitest",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "ai",
    "agents",
    "autonomous",
    "development",
    "cli",
    "devtools"
  ],
  "author": "Rathi Industries",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishan190425/autonomous-dev-agents.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ishan190425/autonomous-dev-agents#readme",
  "bugs": {
    "url": "https://github.com/ishan190425/autonomous-dev-agents/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ada-ai/core": "*",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "vitest": "^4.1.0"
  }
}
