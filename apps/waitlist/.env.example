# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/<project-id>/settings/api

# Supabase Project URL
VITE_SUPABASE_URL=https://ldzxplhmtxfhiunpzmnt.supabase.co

# Supabase Anon/Public Key (safe to expose in frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Notes:
# - These variables are prefixed with VITE_ so Vite exposes them to the client
# - The publishable key is safe to commit; the service role key should NEVER be committed
# - For Vercel deployment, add these in Project Settings → Environment Variables
